{
  "manifest_version": 3,
  "name": "AutoJobs Copilot",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}
